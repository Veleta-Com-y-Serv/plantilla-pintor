---
// Cómo trabajo: banda amarilla partida 50/50, con la foto a sangre a la izquierda (`imagen`, rematada con una
// pasada azul) y, a la derecha, los pasos en una línea vertical de muestras cuadradas numeradas (visita,
// presupuesto cerrado, protección, pintura, limpieza…). Campos: `items[]` (titulo, texto, icono), `imagen`, `cta`.
// Sin foto, una sola columna con los pasos en rejilla.
import { seccion, conTitulo } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const pasos = s ? conTitulo(s.items) : [];
const hay = !!s && !!(s.titulo || s.antetitulo || s.texto || pasos.length || s.imagen);
---

{
  s && hay && (
    <section id={Astro.props.id} class:list={['banda banda--amarilla', { 'banda--sin-relleno': !!s.imagen }]}>
      <div class:list={[s.imagen ? 'partida partida--foto-izq' : 'contenedor']}>
        <div class:list={[{ 'partida-texto partida-texto--der': !!s.imagen }]}>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {pasos.length > 0 && (
            <ol class:list={['pasos', { 'pasos--rejilla': !s.imagen }]}>
              {pasos.map((p, i) => (
                <li class="paso">
                  <span class="paso-num" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{p.titulo}</h3>
                    {p.texto && <p>{p.texto}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}
          {s.cta?.url && <a class="btn btn--noche mt-10" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
        {s.imagen && (
          <div class="partida-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1400} />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .pasos { display: grid; gap: 0; }
  .paso { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; padding-bottom: 1.9rem; }
  .paso:last-child { padding-bottom: 0; }
  .paso::before { content: ""; position: absolute; left: 1.5rem; top: 3rem; bottom: 0; width: 3px; transform: translateX(-50%); background: var(--sobre-acento); opacity: .25; }
  .paso:last-child::before { display: none; }
  .paso-num { display: grid; place-items: center; width: 3rem; height: 3rem; background: var(--noche); color: var(--c-acento); font-family: var(--fuente-titulos); font-weight: 900; font-size: 1.3rem; }
  .paso h3 { font-size: clamp(1.2rem, 1.8vw, 1.5rem); padding-top: .55rem; }
  .paso p { margin-top: .4rem; opacity: .88; max-width: 34rem; }
  @media (min-width: 900px) {
    .pasos--rejilla { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem; }
    .pasos--rejilla .paso { grid-template-columns: 1fr; padding-bottom: 0; }
    .pasos--rejilla .paso::before { display: none; }
  }
</style>
