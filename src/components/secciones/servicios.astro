---
// Servicios en banda azul a todo el ancho: titular partido y una rejilla de 1, 2 o 3 columnas sin tarjetas, cada
// servicio bajo un filo grueso, con su número en serif cursiva amarilla, su icono en cuadrado, título, texto y el
// precio orientativo opcional («desde 6 €/m²») como etiqueta amarilla. Campos: `items[]` (titulo, texto, icono, precio).
import { seccion, conTitulo } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? conTitulo(s.items) : [];
const hay = !!s && !!(s.titulo || s.antetitulo || s.texto || items.length);
---

{
  s && hay && (
    <section id={Astro.props.id} class="banda banda--azul">
      <div class="contenedor">
        <div class="cabeza">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="cabeza-texto">{s.texto}</p>}
        </div>
        {items.length > 0 && (
          <ul class="servicios">
            {items.map((it, i) => (
              <li class="servicio">
                <div class="servicio-cabeza">
                  <span class="servicio-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="cuadro-icono"><Icono nombre={it.icono} tam={26} /></span>
                </div>
                <h3>{it.titulo}</h3>
                {it.texto && <p class="servicio-texto">{it.texto}</p>}
                {it.precio && <p class="servicio-precio">{it.precio}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .servicios { display: grid; gap: 0 clamp(2rem, 4vw, 4.5rem); }
  @media (min-width: 700px) { .servicios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .servicios { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1280px) { .servicios { grid-template-columns: repeat(4, 1fr); } }
  .servicio { border-top: 3px solid var(--linea); padding-block: 1.4rem 2rem; }
  @media (min-width: 700px) { .servicio { padding-block: 1.75rem 2.75rem; } }
  .servicio-cabeza { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .servicio-num { font-family: var(--fuente-serif); font-style: italic; font-size: clamp(2.6rem, 4vw, 3.6rem); line-height: 1; color: var(--c-acento); }
  .servicio h3 { margin-top: 1.4rem; font-size: clamp(1.35rem, 2vw, 1.65rem); }
  .servicio-texto { margin-top: .7rem; opacity: .88; max-width: 34rem; }
  .servicio-precio { display: inline-block; margin-top: 1.2rem; padding: .3rem .75rem; background: var(--c-acento); color: var(--sobre-acento); font-weight: 800; font-size: .95rem; }
</style>
