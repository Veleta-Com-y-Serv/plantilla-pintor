---
// Zonas de trabajo: banda blanca partida 50/50 con los pueblos y comarcas a la izquierda, en dos o tres columnas
// con una muestra cuadrada delante de cada uno, y la foto a sangre a la derecha (`imagen`, con la pasada
// amarilla). Sin foto, la lista ocupa todo el ancho en 2-4 columnas. Campos: `items[]` (titulo, texto opcional).
// Las zonas con `texto` tienen página propia (/zonas/<slug>/) y salen como enlace; el texto largo se muestra recortado.
import { seccion, conTitulo } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import { enlaceDe, resumen } from '../../lib/paginas';
interface Props { id: string }
const s = seccion(Astro.props.id);
const zonas = s ? conTitulo(s.items) : [];
const hay = !!s && !!(s.titulo || s.antetitulo || s.texto || zonas.length || s.imagen);
---

{
  s && hay && (
    <section id={Astro.props.id} class:list={['banda banda--blanca', { 'banda--sin-relleno': !!s.imagen }]}>
      <div class:list={[s.imagen ? 'partida' : 'contenedor']}>
        <div class:list={[{ 'partida-texto partida-texto--izq': !!s.imagen }]}>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {zonas.length > 0 && (
            <ul class:list={['zonas', { 'zonas--ancha': !s.imagen }]}>
              {zonas.map((z) => (
                <li>
                  <span class="zona-muestra" aria-hidden="true" />
                  <span>
                    <strong>{enlaceDe(z) ? <a href={enlaceDe(z)} class="zona-enlace">{z.titulo}</a> : z.titulo}</strong>
                    {z.texto && <small>{enlaceDe(z) ? resumen(z.texto, 110) : z.texto}</small>}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
        {s.imagen && (
          <div class="partida-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1400} alto={1000} />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .zonas { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; border-top: 2px solid var(--linea); }
  @media (min-width: 1200px) { .zonas { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .zonas--ancha { grid-template-columns: repeat(4, 1fr); } }
  .zonas li { position: relative; display: flex; align-items: flex-start; gap: .7rem; padding-block: .9rem; border-bottom: 1px solid var(--linea); }
  .zona-muestra { width: .85rem; height: .85rem; margin-top: .4rem; background: var(--c-primario); flex: none; }
  .zonas li:nth-child(4n + 2) .zona-muestra { background: var(--c-acento); }
  .zonas li:nth-child(4n + 3) .zona-muestra { background: var(--m2); }
  .zonas li:nth-child(4n) .zona-muestra { background: var(--noche); }
  .zona-enlace { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--c-acento); text-underline-offset: 3px; }
  .zona-enlace::after { content: ""; position: absolute; inset: 0; }
  .zona-enlace:focus-visible { outline: none; }
  .zonas li:has(.zona-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: 2px; }
  .zonas strong { display: block; font-weight: 700; line-height: 1.3; }
  .zonas small { display: block; font-size: .85rem; opacity: .7; }
</style>
