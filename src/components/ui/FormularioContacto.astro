---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// Modelos: `contacto` (nombre, email o teléfono, mensaje) y `presupuesto`, corto a propósito: nombre, teléfono,
// qué trabajo (de los servicios; sin servicios, texto libre), pueblo o barrio y qué necesitas. Solo texto.
// `prefijo` hace únicos los ids si hay varios formularios en la página.
import { site } from '../../data/site';
interface Props {
  boton?: string;
  class?: string;
  asunto?: string;
  modelo?: 'contacto' | 'presupuesto';
  servicios?: string[];
  prefijo?: string;
}
const {
  boton = 'Enviar mensaje',
  class: clase = '',
  modelo = 'contacto',
  asunto = modelo === 'presupuesto' ? `Presupuesto desde la web de ${site.nombre}` : `Consulta desde la web de ${site.nombre}`,
  servicios = [],
  prefijo = 'f',
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (campo: string) => `${prefijo}-${campo}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  {
    modelo === 'presupuesto' ? (
      <>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('nombre')}>Nombre</label>
            <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for={id('telefono')}>Teléfono</label>
            <input id={id('telefono')} name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
        </div>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('servicio')}>Qué trabajo</label>
            {servicios.length > 0 ? (
              <select id={id('servicio')} name="trabajo">
                {servicios.map((t) => <option value={t}>{t}</option>)}
                <option value="Otro">Otro</option>
              </select>
            ) : (
              <input id={id('servicio')} name="trabajo" type="text" />
            )}
          </div>
          <div class="campo">
            <label for={id('localidad')}>Pueblo o barrio</label>
            <input id={id('localidad')} name="localidad" type="text" autocomplete="address-level2" />
          </div>
        </div>
        <div class="campo">
          <label for={id('mensaje')}>¿Qué necesitas?</label>
          <textarea id={id('mensaje')} name="mensaje" rows="4" required placeholder="Por ejemplo: pintar un piso de tres habitaciones en blanco roto."></textarea>
        </div>
      </>
    ) : (
      <>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('nombre')}>Nombre</label>
            <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for={id('contacto')}>Email o teléfono</label>
            <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
          </div>
        </div>
        <div class="campo">
          <label for={id('mensaje')}>Mensaje</label>
          <textarea id={id('mensaje')} name="mensaje" rows="4" required></textarea>
        </div>
      </>
    )
  }
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn btn--azul">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
