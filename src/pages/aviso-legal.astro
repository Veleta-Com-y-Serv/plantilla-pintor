---
// Página adicional con el diseño de la plantilla: banda azul con el título y la carta de colores debajo; luego,
// los datos del titular a la izquierda y el texto a la derecha. Se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site, tel } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--azul">
    <div class="contenedor">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo-seccion">Aviso legal y <span class="cursiva">privacidad</span></h1>
    </div>
  </section>
  <div class="carta" style="--muestras:6" aria-hidden="true">
    <span class="muestra min-h-4!"></span><span class="muestra min-h-4!"></span><span class="muestra min-h-4!"></span>
    <span class="muestra min-h-4!"></span><span class="muestra min-h-4!"></span><span class="muestra min-h-4!"></span>
  </div>
  <section class="banda banda--blanca">
    <div class="contenedor grid gap-12 md:grid-cols-[1fr_2fr] md:gap-20">
      <aside class="md:sticky md:top-28 md:self-start">
        <p class="antetitulo">Titular de la web</p>
        <p class="mt-4 font-display text-2xl font-black">{site.nombre}</p>
        <ul class="mt-4 grid gap-2 opacity-85">
          {c.direccion && <li>{c.direccion}</li>}
          {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
          {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
        </ul>
      </aside>
      <article class="texto-largo max-w-3xl">
        <h2>Quién está detrás</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos o pedir presupuesto: nombre, forma de contacto y lo que nos cuentas de
          tu casa. Los usamos para responderte. No los cedemos a nadie salvo obligación legal.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
        <p class="mt-10"><a class="btn btn--azul" href="/">Volver al inicio</a></p>
      </article>
    </div>
  </section>
</Base>
